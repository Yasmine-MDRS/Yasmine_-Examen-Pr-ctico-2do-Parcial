body {
  font-family: 'Roboto', sans-serif;
}

.card {
  width: 100%;
  max-width: 450px;
  border-radius: 15px;
  background-color: #5f73b3;
  color: white;
}

.card-title {
  font-weight: 500;
}

.form-label {
  font-size: 14px;
}

.btn-success {
  background-color: #8ae2c8;
  border-color: #8ae2c8;
}

.btn-success:hover {
  background-color: #79d1b4;
  border-color: #79d1b4;
}
